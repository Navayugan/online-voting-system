# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it contains your secrets.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=employee_voting_system
PORT=8000

# Must be at least 32 characters long
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long

# Your frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Set to 1 if behind a reverse-proxy (NGINX, Cloudflare, etc.)
TRUST_PROXY=1

# Controls when election results are visible to employees
# Options: live (as votes come in) | closed (only after election closes)
RESULTS_VISIBILITY=live
