# .env.example - copy to .env and fill in values for local/deployment
# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
DB_PASSWORD=your_root_password
DB_NAME=employee_voting_system

# JWT configuration (minimum 32 characters)
JWT_SECRET=change_this_to_a_32+_char_secret_string

# Frontend URL (comma‑separated if multiple origins)
FRONTEND_URL=http://localhost:3000

# Optional: trust proxy if behind a reverse proxy (0 or 1)
TRUST_PROXY=1
